  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Inter",
          "system-ui",
          "-apple-system",
          "sans-serif"
        ],
        "$description": "Default UI and body typeface (Atelier --font-sans): Inter for body copy, UI labels, buttons, stats, and captions. Weights used: 400, 600, 800."
      },
      "serif": {
        "$value": [
          "Comfortaa",
          "Inter",
          "Georgia",
          "serif"
        ],
        "$description": "Atelier's --font-serif resolves to Comfortaa — the heading/display face (weights 400 and 700 only; Comfortaa has no italic, so italic accents use font-style)."
      },
      "mono": {
        "$value": [
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "monospace"
        ],
        "$description": "Eyebrows, section labels, telemetry chips (Atelier --font-mono)."
      },
      "wordmark": {
        "$value": [
          "Comfortaa",
          "system-ui",
          "sans-serif"
        ],
        "$description": "Display face for the brand wordmark in the title bar (--font-wordmark). Defaults to the heading face; override when a client's wordmark uses its own type."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.625rem",
      "$description": "Atelier --radius: 10px. Cards use the 16px large radius (--radius-xl override in the brand layer)."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  },
  "brand": {
    "$description": "Per-client brand layer: the signature accent gradient, status hues, backdrop gradient stops, the backdrop wallpaper art, and the hero 'dark island'. These drive the CSS custom properties in the brand layer of scripts/theme-template.css.",
    "gradient": {
      "$type": "color",
      "$description": "Four stops of the signature left-to-right accent gradient (--brand-grad): section dividers, brand rules, logo-adjacent flourishes. Derived from the client logo; stop3 should match (or sit close to) color.dark.primary.",
      "stop1": {
        "$value": "#7659DF"
      },
      "stop2": {
        "$value": "#A557C8"
      },
      "stop3": {
        "$value": "#DB509E"
      },
      "stop4": {
        "$value": "#FF775D"
      }
    },
    "status": {
      "$type": "color",
      "$description": "Success / warning / danger hues per theme. Keep these recognisably green, amber and red even when the client palette is unusual — status is not brand.",
      "light": {
        "success": {
          "$value": "#15803D"
        },
        "warn": {
          "$value": "#B45309"
        },
        "danger": {
          "$value": "#B91C1C"
        }
      },
      "dark": {
        "success": {
          "$value": "#4ADE80"
        },
        "warn": {
          "$value": "#FBBF24"
        },
        "danger": {
          "$value": "#F87171"
        }
      }
    },
    "backdrop": {
      "$type": "color",
      "$description": "Three stops of the fixed 160° backdrop gradient (.cog-backdrop). This is the light-mode and dark-mode backdrop the client asked for: deep = top-left, mid = middle, hi = bottom-right. It also shows while the wallpaper art loads.",
      "light": {
        "deep": {
          "$value": "#EEF0F5"
        },
        "mid": {
          "$value": "#FDFBF7"
        },
        "hi": {
          "$value": "#FFFFFF"
        }
      },
      "dark": {
        "deep": {
          "$value": "#071936"
        },
        "mid": {
          "$value": "#0B2246"
        },
        "hi": {
          "$value": "#122B57"
        }
      }
    },
    "backdropArt": {
      "$description": "URLs of the wallpaper layer (.cog-backdrop-art) per theme, resolved from the app's public root. Set to \"none\" to ship the gradient alone.",
      "light": {
        "$value": "url('/brand/light-backdrop.webp')"
      },
      "dark": {
        "$value": "url('/brand/dark-backdrop.webp')"
      }
    },
    "backdropArtOpacity": {
      "$description": "Opacity of the wallpaper layer per theme. Lower it when client artwork is busy enough to hurt text contrast over glass surfaces.",
      "light": {
        "$value": "1"
      },
      "dark": {
        "$value": "1"
      }
    },
    "hero": {
      "$type": "color",
      "$description": "The .page-hero 'dark island': a full-width header band that keeps the client's deep brand surface in BOTH themes. These re-declare the core tokens inside the island so children stay legible over it.",
      "background": {
        "$value": "#071936"
      },
      "foreground": {
        "$value": "#EEF1FA"
      },
      "card": {
        "$value": "#0B2246"
      },
      "cardForeground": {
        "$value": "#EEF1FA"
      },
      "border": {
        "$value": "#243B66"
      },
      "mutedForeground": {
        "$value": "#9FB0CC"
      },
      "primary": {
        "$value": "#E980BC"
      },
      "primaryForeground": {
        "$value": "#071936"
      }
    }
  }
}