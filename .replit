# Dhow on Replit. Press Run: installs once, builds the web app, creates and
# seeds the database on first start, and serves everything on one port.
modules = ["nodejs-20", "postgresql-16"]
run = "bash tools/replit-run.sh"
entrypoint = "apps/server/src/index.ts"

[nix]
channel = "stable-24_05"

[env]
PORT = "5000"

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Dhow"

[[workflows.workflow]]
name = "Dhow"
author = "agent"
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash tools/replit-run.sh"
waitForPort = 5000

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "-c", "npm install --include=dev --no-audit --no-fund && npm run build"]
run = ["npm", "start"]
